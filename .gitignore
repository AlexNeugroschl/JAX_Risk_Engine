# Virtual environments
venv/
.venv/

# Local presentation drafts and generated artifacts
/artifacts/

# Python / tooling caches and build artifacts
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local agent state
.claude/

# Engine outputs. Generated cubes and reports are never source.
*.npy
*.csv
*.json

# ...but the hash-pinned TraderX EOD fixtures are source, not output. The
# blanket *.csv / *.json rules above would silently swallow them, leaving
# tests/test_integration_*.py passing locally and failing on a fresh clone.
# The directory must be un-ignored before its contents can be.
# See also .gitattributes -- these files must never be CRLF-translated.
!tests/fixtures/
!tests/fixtures/**/
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.json

# The precision evidence table's source and its rows (I-55) are source too: the acceptance
# standard, and the rows the engine reads to warn (generated, but shipped with the package and
# held to the measurements by tests/test_precision_evidence.py).
!compliance/precision-acceptance.json
!engine/precision/evidence.json

# JAX's persistent XLA compilation cache (tests/conftest.py).
.jax_cache/

# Profiler traces (JAX_RISK_PROFILE_DIR) -- .profile-out/.profile-out-small are
# the demos' own defaults; the glob covers ad-hoc dirs from a manual capture.
.profile-out*/

# reference/ORE and reference/traderX are git submodules (see .gitmodules).
